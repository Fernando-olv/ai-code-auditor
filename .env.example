# Copy to `.env` for local overrides (not committed).
APP_ENV=development
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=
# Required for PR metadata/diff retrieval (Milestone 2+). Not used for webhook signature verification.
GITHUB_TOKEN=
# Optional override (e.g. GitHub Enterprise): default is https://api.github.com
# GITHUB_API_BASE_URL=
