# Copy to `.env` for local overrides (not committed).
APP_ENV=development
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=
# Required for PR metadata/diff retrieval (Milestone 2+). Not used for webhook signature verification.
GITHUB_TOKEN=
# Optional override (e.g. GitHub Enterprise): default is https://api.github.com
# GITHUB_API_BASE_URL=

# LLM: openai (default) or gemini (Google AI Studio API key).
# LLM_PROVIDER=openai
# OpenAI-compatible API — used when LLM_PROVIDER=openai. Leave OPENAI_API_KEY empty to skip.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Google AI Studio (Gemini) — used when LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Optional: repo root containing the `ai/` folder when not running from source checkout
# AI_REPO_ROOT=

# Firestore (Milestone 6+). On Cloud Run set GOOGLE_CLOUD_PROJECT to your GCP project id (ADC supplies credentials).
GOOGLE_CLOUD_PROJECT=
# Optional non-default database id; leave empty or use "(default)" for the default database.
# FIRESTORE_DATABASE_ID=
# Local emulator only — do not set on Cloud Run. Example: 127.0.0.1:8080
# FIRESTORE_EMULATOR_HOST=
