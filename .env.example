# Copy to `.env` for local overrides (not committed).
APP_ENV=development
LOG_LEVEL=INFO
GITHUB_WEBHOOK_SECRET=
# Required for PR metadata/diff retrieval (Milestone 2+). Not used for webhook signature verification.
GITHUB_TOKEN=
# Optional override (e.g. GitHub Enterprise): default is https://api.github.com
# GITHUB_API_BASE_URL=

# OpenAI-compatible API (Milestone 4+). Leave empty to skip LLM review at runtime.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Optional: repo root containing the `ai/` folder when not running from source checkout
# AI_REPO_ROOT=
